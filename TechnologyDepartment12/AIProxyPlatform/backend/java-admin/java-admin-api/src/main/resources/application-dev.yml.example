# ============================================================
# application-dev.yml 示例（可提交，无真实密钥）
#
#   copy application-dev.yml.example application-dev.yml
#   再编辑 application-dev.yml 填入本地密钥
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:127.0.0.1}:${MYSQL_PORT:4336}/${MYSQL_DATABASE:javaadmin_dev}?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    username: ${MYSQL_USER:root}
    password: ${MYSQL_PASSWORD:root}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 16
      minimum-idle: 2
      idle-timeout: 30000

  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:4379}
      # 本地 compose Redis 默认 requirepass=123456；无密码环境请用 test profile 或 REDIS_PASSWORD=
      password: ${REDIS_PASSWORD:123456}
      timeout: 10s
      database: 0
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 1

  flyway:
    locations: classpath:db/migration

  temporal:
    connection:
      target: ${TEMPORAL_TARGET:127.0.0.1:4723}
    start-workers: ${TEMPORAL_START_WORKERS:true}

logging:
  level:
    root: INFO
    com.yunpei.proxy: DEBUG

knife4j:
  enable: true
  setting:
    language: zh_cn

# ---------- 图片生成（在此填写真实 key / 接入点，本 example 仅占位） ----------
image:
  provider: new2api
  new2api:
    # 二选一：写明文 api-key，或只设环境变量 NEW2API_API_KEY / IMAGE_API_KEY
    api-key: ${NEW2API_API_KEY:${IMAGE_API_KEY:}}
    base-url: ${NEW2API_BASE_URL:}
    model: ${NEW2API_IMAGE_MODEL:image}
    timeout-seconds: 120
    # 并发上限见 spring.temporal.workers（image-generation capacity / IMAGE_MAX_CONCURRENT_ACTIVITIES）
    # 失败后重试等待秒数（首次立即；失败后按数组 sleep 再试；[] 表示不重试）
    retry-delays-seconds:
      - 1
      - 2
      - 5

# ---------- 视频生成（在此填写真实 key / 接入点） ----------
# VIDEO_PROVIDER=placeholder|new2api|cpa
video:
  provider: ${VIDEO_PROVIDER:placeholder}
  new2api:
    api-key: ${NEW2API_API_KEY:${VIDEO_API_KEY:}}
    base-url: ${NEW2API_BASE_URL:}
    model: ${NEW2API_VIDEO_MODEL:video}
    timeout-seconds: 1800
    retry-delays-seconds:
      - 1
      - 2
      - 5
  cpa:
    api-key: ${CPA_API_KEY:${VIDEO_CPA_API_KEY:}}
    base-url: ${CPA_BASE_URL}
    model: ${CPA_VIDEO_MODEL}
    timeout-seconds: 1800
    retry-delays-seconds:
      - 1
      - 2
      - 5

# ---------- OSS / S3（在此填写真实 AK/SK，本 example 仅占位） ----------
oss:
  enabled: false
  endpoint: ${OSS_ENDPOINT:}
  region: ${OSS_REGION:ap-east-1}
  bucket: ${OSS_BUCKET:}
  access-key: ${OSS_ACCESS_KEY:}
  secret-key: ${OSS_SECRET_KEY:}
  path-style: false
  public-base-url: ${OSS_PUBLIC_BASE_URL:}
  key-prefix: advertising
  download-timeout-seconds: 60
